# Antes: mvn dependency:copy -Dartifact=org.mariadb.jdbc:mariadb-java-client:3.3.3 -DoutputDirectory=target
if (outcome != success) of /deployment=mariadb-java-client-3.3.3.jar:read-resource
  deploy target/mariadb-java-client-3.3.3.jar
end-if
if (outcome != success) of /subsystem=datasources/data-source=ejb-jpa-wildfly:read-resource
  data-source add --name=ejb-jpa-wildfly --jndi-name=java:/jdbc/ejb-jpa-wildfly --driver-name=mariadb-java-client-3.3.3.jar --connection-url="jdbc:mariadb://${env.DB_HOST:localhost}:${env.DB_PORT:3306}/${env.DB_NAME:ejb_jpa_wildfly}" --user-name="${env.DB_USER}" --password="${env.DB_PASSWORD}"
end-if
/subsystem=datasources/data-source=ejb-jpa-wildfly:test-connection-in-pool
