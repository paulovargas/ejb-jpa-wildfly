# Execute com o servidor iniciado: jboss-cli.bat --connect --file=config/security.cli
# Domínio exclusivo da aplicação; não altera o domínio padrão de outras aplicações.
if (outcome != success) of /subsystem=undertow/application-security-domain=jwt-app:read-resource
  /subsystem=undertow/application-security-domain=jwt-app:add(security-domain=ApplicationDomain, integrated-jaspi=false)
end-if
if (outcome != success) of /subsystem=ejb3/application-security-domain=jwt-app:read-resource
  /subsystem=ejb3/application-security-domain=jwt-app:add(security-domain=ApplicationDomain)
end-if
:reload
